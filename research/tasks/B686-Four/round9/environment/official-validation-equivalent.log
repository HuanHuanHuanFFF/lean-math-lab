def Math.A071999.matrix : (n : ℕ) → Matrix (Fin n) (Fin n) ℤ :=
fun n i j => if i = j then 1 else if ↑i + ↑j + 2 = n then ↑↑i + 1 else 0
det_matrix : ∀ (n : ℕ), (matrix n).det = ∏ i ∈ Finset.Icc 1 ((n - 1) / 2), (1 - ↑i * (↑n - ↑i))
