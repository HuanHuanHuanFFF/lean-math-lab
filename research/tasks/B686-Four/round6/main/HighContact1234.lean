theorem identity1234_4 (u v q : ℤ) :
    2187 * auxiliary1234 (-3 + q * u) (q * v) =
      quotient1234_4 (q * u) (q * v) * curve (-3 + q * u) (q * v) +
        q ^ 18 * residual1234_4 u v q := by
  unfold auxiliary1234 quotient1234_4 curve residual1234_4
  ring

theorem contact1234_4 (z d q : ℤ) (hy : q ∣ z - (-3)) (hd : q ∣ d)
    (hc : IsCoprime q (6 : ℤ)) (hcurve : curve z d = 0) : q ^ 18 ∣ auxiliary1234 z d := by
  have hK : IsCoprime q (2187 : ℤ) :=
    (hc.pow_right (n := 7)).of_isCoprime_of_dvd_right (by norm_num)
  apply (hK.pow_left (m := 18)).dvd_of_dvd_mul_left
  obtain ⟨u, hu⟩ := hy
  obtain ⟨v, rfl⟩ := hd
  have hz : z = -3 + q * u := by omega
  subst z
  try simp only [zero_add] at hcurve
  refine ⟨residual1234_4 u v q, ?_⟩
  simpa only [hcurve, mul_zero, zero_add] using identity1234_4 u v q

theorem four_position_contact1234 (n d P Q R S : ℤ)
    (heq : product 5 (n + d) = 4 * product 5 n)
    (hd : d = P * Q * R * S)
    (hP : P ∣ n + 1) (hQ : Q ∣ n + 2) (hR : R ∣ n + 3) (hS : S ∣ n + 4)
    (hPQ : IsCoprime P Q) (hPR : IsCoprime P R) (hPS : IsCoprime P S)
    (hQR : IsCoprime Q R) (hQS : IsCoprime Q S) (hRS : IsCoprime R S)
    (h6 : IsCoprime d (6 : ℤ)) : d ^ 18 ∣ auxiliary1234 (3 * (n + 3) - d) d := by
  have hPd : P ∣ d := by
    rw [hd]
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_right P Q) R) S
  have hQd : Q ∣ d := by
    rw [hd]
    exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left (dvd_mul_left Q P) R) S
  have hRd : R ∣ d := by
    rw [hd]
    exact dvd_mul_of_dvd_left (dvd_mul_left R (P * Q)) S
  have hSd : S ∣ d := by rw [hd]; exact dvd_mul_left S (P * Q * R)
  have hProot : P ∣ 3 * (n + 3) - d - (6) := by
    have hid : 3 * (n + 3) - d - (6) = 3 * (n + 1) - d := by ring
    rw [hid]
    exact dvd_sub (dvd_mul_of_dvd_right hP 3) hPd
  have hQroot : Q ∣ 3 * (n + 3) - d - (3) := by
    have hid : 3 * (n + 3) - d - (3) = 3 * (n + 2) - d := by ring
    rw [hid]
    exact dvd_sub (dvd_mul_of_dvd_right hQ 3) hQd
  have hRroot : R ∣ 3 * (n + 3) - d - (0) := by
    have hid : 3 * (n + 3) - d - (0) = 3 * (n + 3) - d := by ring
    rw [hid]
    exact dvd_sub (dvd_mul_of_dvd_right hR 3) hRd
  have hSroot : S ∣ 3 * (n + 3) - d - (-3) := by
    have hid : 3 * (n + 3) - d - (-3) = 3 * (n + 4) - d := by ring
    rw [hid]
    exact dvd_sub (dvd_mul_of_dvd_right hS 3) hSd
  have hc := curve_of_original n d heq
  have hPpow := contact1234_1 _ _ _ hProot hPd (h6.of_isCoprime_of_dvd_left hPd) hc
  have hQpow := contact1234_2 _ _ _ hQroot hQd (h6.of_isCoprime_of_dvd_left hQd) hc
  have hRpow := contact1234_3 _ _ _ hRroot hRd (h6.of_isCoprime_of_dvd_left hRd) hc
  have hSpow := contact1234_4 _ _ _ hSroot hSd (h6.of_isCoprime_of_dvd_left hSd) hc
  have hPQR := (hPR.pow.mul_left hQR.pow).mul_dvd ((hPQ.pow).mul_dvd hPpow hQpow) hRpow
  have hall := ((hPS.pow.mul_left hQS.pow).mul_left hRS.pow).mul_dvd hPQR hSpow
  simpa only [← mul_pow, ← hd] using hall

