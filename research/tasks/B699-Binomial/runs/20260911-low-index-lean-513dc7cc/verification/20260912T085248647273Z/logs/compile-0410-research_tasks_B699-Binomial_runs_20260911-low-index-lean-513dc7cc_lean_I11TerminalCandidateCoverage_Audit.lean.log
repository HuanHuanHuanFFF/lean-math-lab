@B699LowIndex.I11TerminalCover.witnessCheck_sound : ∀ {w : B699LowIndex.I11TerminalCover.Witness},
  B699LowIndex.I11TerminalCover.witnessCheck w = true →
    ∀ {n j : ℕ},
      B699LowIndex.intervalMem n (B699LowIndex.I11TerminalCover.witnessBounds w) →
        11 < j → j ≤ n / 2 → B699LargePrimeStructure.Common n 11 j
