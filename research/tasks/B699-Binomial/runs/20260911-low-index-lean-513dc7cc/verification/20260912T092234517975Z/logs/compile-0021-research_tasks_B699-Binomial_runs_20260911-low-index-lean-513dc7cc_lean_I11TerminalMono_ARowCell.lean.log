def Math.B699.I11TerminalCRT.rowCoverCheck : ℕ → ℕ → ℕ → ℕ → ℕ → ℤ → BoundsDatum → List NatInterval → Bool :=
fun P Q v capA capC d bounds candidates =>
  pairBoundCheck P Q v capA capC 10 d bounds &&
    (parameters bounds).all fun t =>
      coverCheck (parameterInterval P Q v d t).1 (parameterInterval P Q v d t).2 candidates
def Math.B699.I11TerminalCRT.cellCoverCheck : ℕ → ℕ → ℕ → ℕ → CellData → List NatInterval → Bool :=
fun P Q capA capC data candidates =>
  shifts.all fun d => rowCoverCheck P Q data.inverse capA capC d (data.bounds d) candidates
