theorem rowA50_block_check :
    blockCheck 2 3 Stage01.H Stage01.M Stage01.upper 50 1 1 38 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 50 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA50_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 50 b = rowA50 b from rfl] using h

