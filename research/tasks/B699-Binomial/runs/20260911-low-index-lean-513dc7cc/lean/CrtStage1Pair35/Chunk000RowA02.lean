theorem rowA2_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 25) :
    cellCheck (3 ^ 2) (5 ^ b)
      (heightCap Stage01.H Stage01.M (3 ^ 2))
      (heightCap Stage01.H Stage01.M (5 ^ b)) Stage01.upper (rowA2 b) = true := by
