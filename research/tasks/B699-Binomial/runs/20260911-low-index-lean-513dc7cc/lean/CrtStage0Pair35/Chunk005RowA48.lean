theorem rowA48_block_check :
    blockCheck 3 5 Stage00.H Stage00.M Stage00.upper 48 1 1 46 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 48 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA48_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 48 b = rowA48 b from rfl] using h

