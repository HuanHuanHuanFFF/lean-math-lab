theorem rowA56_block_check :
    blockCheck 2 5 Stage01.H Stage01.M Stage01.upper 56 1 1 25 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 56 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA56_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 56 b = rowA56 b from rfl] using h

