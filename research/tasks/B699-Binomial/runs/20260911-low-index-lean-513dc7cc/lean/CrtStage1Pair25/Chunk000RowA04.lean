theorem rowA4_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 25) :
    cellCheck (2 ^ 4) (5 ^ b)
      (heightCap Stage01.H Stage01.M (2 ^ 4))
      (heightCap Stage01.H Stage01.M (5 ^ b)) Stage01.upper (rowA4 b) = true := by
  interval_cases b
  · simpa only [show rowA4 1 = cellA4B1 from rfl] using cellA4B1_check
