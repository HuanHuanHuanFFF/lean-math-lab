  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 81 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA81_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 81 b = rowA81 b from rfl] using h

