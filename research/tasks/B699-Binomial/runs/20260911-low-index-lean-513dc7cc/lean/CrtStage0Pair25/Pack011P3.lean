theorem rowA95_block_check :
    blockCheck 2 5 Stage00.H Stage00.M Stage00.upper 95 1 1 46 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 95 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA95_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 95 b = rowA95 b from rfl] using h

