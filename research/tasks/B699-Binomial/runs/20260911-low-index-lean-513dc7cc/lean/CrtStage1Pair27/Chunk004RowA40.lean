theorem rowA40_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 21) :
    cellCheck (2 ^ 40) (7 ^ b)
      (heightCap Stage01.H Stage01.M (2 ^ 40))
      (heightCap Stage01.H Stage01.M (7 ^ b)) Stage01.upper (rowA40 b) = true := by
