  · simpa only [show rowA40 18 = cellA40B18 from rfl] using cellA40B18_check
  · simpa only [show rowA40 19 = cellA40B19 from rfl] using cellA40B19_check
  · simpa only [show rowA40 20 = cellA40B20 from rfl] using cellA40B20_check
  · simpa only [show rowA40 21 = cellA40B21 from rfl] using cellA40B21_check

theorem rowA40_block_check :
    blockCheck 2 7 Stage01.H Stage01.M Stage01.upper 40 1 1 21 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 40 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA40_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 40 b = rowA40 b from rfl] using h

