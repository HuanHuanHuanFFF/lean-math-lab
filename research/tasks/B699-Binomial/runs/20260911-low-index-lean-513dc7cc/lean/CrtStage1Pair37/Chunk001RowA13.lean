  · simpa only [show rowA13 17 = cellA13B17 from rfl] using cellA13B17_check
  · simpa only [show rowA13 18 = cellA13B18 from rfl] using cellA13B18_check
  · simpa only [show rowA13 19 = cellA13B19 from rfl] using cellA13B19_check
  · simpa only [show rowA13 20 = cellA13B20 from rfl] using cellA13B20_check
  · simpa only [show rowA13 21 = cellA13B21 from rfl] using cellA13B21_check

theorem rowA13_block_check :
    blockCheck 3 7 Stage01.H Stage01.M Stage01.upper 13 1 1 21 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 13 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA13_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 13 b = rowA13 b from rfl] using h

