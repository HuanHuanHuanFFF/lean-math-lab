theorem rowA13_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 21) :
    cellCheck (3 ^ 13) (7 ^ b)
      (heightCap Stage01.H Stage01.M (3 ^ 13))
      (heightCap Stage01.H Stage01.M (7 ^ b)) Stage01.upper (rowA13 b) = true := by
