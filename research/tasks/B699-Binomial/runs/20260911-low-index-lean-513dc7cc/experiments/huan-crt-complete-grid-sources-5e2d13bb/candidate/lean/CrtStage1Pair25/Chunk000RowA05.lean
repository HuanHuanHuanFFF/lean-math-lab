theorem rowA5_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 25) :
    cellCheck (2 ^ 5) (5 ^ b)
      (heightCap Stage01.H Stage01.M (2 ^ 5))
      (heightCap Stage01.H Stage01.M (5 ^ b)) Stage01.upper (rowA5 b) = true := by
