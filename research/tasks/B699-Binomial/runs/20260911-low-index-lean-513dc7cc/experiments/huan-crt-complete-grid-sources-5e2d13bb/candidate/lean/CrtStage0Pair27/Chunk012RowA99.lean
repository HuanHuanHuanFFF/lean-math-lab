theorem rowA99_block_check :
    blockCheck 2 7 Stage00.H Stage00.M Stage00.upper 99 1 1 38 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 99 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA99_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 99 b = rowA99 b from rfl] using h

