  · simpa only [show rowA45 8 = cellA45B8 from rfl] using cellA45B8_check
  · simpa only [show rowA45 9 = cellA45B9 from rfl] using cellA45B9_check
  · simpa only [show rowA45 10 = cellA45B10 from rfl] using cellA45B10_check
  · simpa only [show rowA45 11 = cellA45B11 from rfl] using cellA45B11_check
  · simpa only [show rowA45 12 = cellA45B12 from rfl] using cellA45B12_check
  · simpa only [show rowA45 13 = cellA45B13 from rfl] using cellA45B13_check
  · simpa only [show rowA45 14 = cellA45B14 from rfl] using cellA45B14_check
  · simpa only [show rowA45 15 = cellA45B15 from rfl] using cellA45B15_check
  · simpa only [show rowA45 16 = cellA45B16 from rfl] using cellA45B16_check
  · simpa only [show rowA45 17 = cellA45B17 from rfl] using cellA45B17_check
  · simpa only [show rowA45 18 = cellA45B18 from rfl] using cellA45B18_check
  · simpa only [show rowA45 19 = cellA45B19 from rfl] using cellA45B19_check
  · simpa only [show rowA45 20 = cellA45B20 from rfl] using cellA45B20_check
  · simpa only [show rowA45 21 = cellA45B21 from rfl] using cellA45B21_check

theorem rowA45_block_check :
    blockCheck 2 7 Stage01.H Stage01.M Stage01.upper 45 1 1 21 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 45 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA45_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 45 b = rowA45 b from rfl] using h

