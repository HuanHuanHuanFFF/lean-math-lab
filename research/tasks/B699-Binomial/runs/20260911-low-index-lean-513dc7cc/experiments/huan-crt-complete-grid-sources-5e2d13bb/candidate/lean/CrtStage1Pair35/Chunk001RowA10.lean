theorem rowA10_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 25) :
    cellCheck (3 ^ 10) (5 ^ b)
      (heightCap Stage01.H Stage01.M (3 ^ 10))
      (heightCap Stage01.H Stage01.M (5 ^ b)) Stage01.upper (rowA10 b) = true := by
