theorem rowA58_block_check :
    blockCheck 2 7 Stage01.H Stage01.M Stage01.upper 58 1 1 21 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 58 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA58_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 58 b = rowA58 b from rfl] using h

