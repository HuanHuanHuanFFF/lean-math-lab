  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 102 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA102_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 102 b = rowA102 b from rfl] using h

