theorem rowA56_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 25) :
    cellCheck (2 ^ 56) (5 ^ b)
      (heightCap Stage01.H Stage01.M (2 ^ 56))
      (heightCap Stage01.H Stage01.M (5 ^ b)) Stage01.upper (rowA56 b) = true := by
  interval_cases b
  · simpa only [show rowA56 1 = cellA56B1 from rfl] using cellA56B1_check
  · simpa only [show rowA56 2 = cellA56B2 from rfl] using cellA56B2_check
