theorem rowA48_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 25) :
    cellCheck (2 ^ 48) (5 ^ b)
      (heightCap Stage01.H Stage01.M (2 ^ 48))
      (heightCap Stage01.H Stage01.M (5 ^ b)) Stage01.upper (rowA48 b) = true := by
  interval_cases b
  · simpa only [show rowA48 1 = cellA48B1 from rfl] using cellA48B1_check
  · simpa only [show rowA48 2 = cellA48B2 from rfl] using cellA48B2_check
  · simpa only [show rowA48 3 = cellA48B3 from rfl] using cellA48B3_check
  · simpa only [show rowA48 4 = cellA48B4 from rfl] using cellA48B4_check
  · simpa only [show rowA48 5 = cellA48B5 from rfl] using cellA48B5_check
  · simpa only [show rowA48 6 = cellA48B6 from rfl] using cellA48B6_check
  · simpa only [show rowA48 7 = cellA48B7 from rfl] using cellA48B7_check
  · simpa only [show rowA48 8 = cellA48B8 from rfl] using cellA48B8_check
  · simpa only [show rowA48 9 = cellA48B9 from rfl] using cellA48B9_check
  · simpa only [show rowA48 10 = cellA48B10 from rfl] using cellA48B10_check
  · simpa only [show rowA48 11 = cellA48B11 from rfl] using cellA48B11_check
  · simpa only [show rowA48 12 = cellA48B12 from rfl] using cellA48B12_check
  · simpa only [show rowA48 13 = cellA48B13 from rfl] using cellA48B13_check
  · simpa only [show rowA48 14 = cellA48B14 from rfl] using cellA48B14_check
  · simpa only [show rowA48 15 = cellA48B15 from rfl] using cellA48B15_check
  · simpa only [show rowA48 16 = cellA48B16 from rfl] using cellA48B16_check
  · simpa only [show rowA48 17 = cellA48B17 from rfl] using cellA48B17_check
  · simpa only [show rowA48 18 = cellA48B18 from rfl] using cellA48B18_check
  · simpa only [show rowA48 19 = cellA48B19 from rfl] using cellA48B19_check
  · simpa only [show rowA48 20 = cellA48B20 from rfl] using cellA48B20_check
  · simpa only [show rowA48 21 = cellA48B21 from rfl] using cellA48B21_check
  · simpa only [show rowA48 22 = cellA48B22 from rfl] using cellA48B22_check
  · simpa only [show rowA48 23 = cellA48B23 from rfl] using cellA48B23_check
  · simpa only [show rowA48 24 = cellA48B24 from rfl] using cellA48B24_check
  · simpa only [show rowA48 25 = cellA48B25 from rfl] using cellA48B25_check

theorem rowA48_block_check :
    blockCheck 2 5 Stage01.H Stage01.M Stage01.upper 48 1 1 25 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 48 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA48_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 48 b = rowA48 b from rfl] using h

