  · simpa only [show rowA40 8 = cellA40B8 from rfl] using cellA40B8_check
  · simpa only [show rowA40 9 = cellA40B9 from rfl] using cellA40B9_check
  · simpa only [show rowA40 10 = cellA40B10 from rfl] using cellA40B10_check
  · simpa only [show rowA40 11 = cellA40B11 from rfl] using cellA40B11_check
  · simpa only [show rowA40 12 = cellA40B12 from rfl] using cellA40B12_check
  · simpa only [show rowA40 13 = cellA40B13 from rfl] using cellA40B13_check
  · simpa only [show rowA40 14 = cellA40B14 from rfl] using cellA40B14_check
  · simpa only [show rowA40 15 = cellA40B15 from rfl] using cellA40B15_check
  · simpa only [show rowA40 16 = cellA40B16 from rfl] using cellA40B16_check
  · simpa only [show rowA40 17 = cellA40B17 from rfl] using cellA40B17_check
  · simpa only [show rowA40 18 = cellA40B18 from rfl] using cellA40B18_check
  · simpa only [show rowA40 19 = cellA40B19 from rfl] using cellA40B19_check
  · simpa only [show rowA40 20 = cellA40B20 from rfl] using cellA40B20_check
  · simpa only [show rowA40 21 = cellA40B21 from rfl] using cellA40B21_check
  · simpa only [show rowA40 22 = cellA40B22 from rfl] using cellA40B22_check
  · simpa only [show rowA40 23 = cellA40B23 from rfl] using cellA40B23_check
  · simpa only [show rowA40 24 = cellA40B24 from rfl] using cellA40B24_check
  · simpa only [show rowA40 25 = cellA40B25 from rfl] using cellA40B25_check

theorem rowA40_block_check :
    blockCheck 2 5 Stage01.H Stage01.M Stage01.upper 40 1 1 25 chunkData = true := by
  unfold blockCheck
  apply List.all_eq_true.mpr
  intro aa haa
  have hab := List.mem_range'_1.mp haa
  have ha : aa = 40 := by omega
  subst aa
  apply List.all_eq_true.mpr
  intro b hb
  have hbb := List.mem_range'_1.mp hb
  have h := rowA40_cell_check b hbb.1 (by omega)
  simpa only [show chunkData 40 b = rowA40 b from rfl] using h

