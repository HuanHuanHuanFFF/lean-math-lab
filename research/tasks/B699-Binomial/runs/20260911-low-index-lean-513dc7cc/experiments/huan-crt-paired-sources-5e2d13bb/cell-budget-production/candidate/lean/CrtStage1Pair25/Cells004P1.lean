theorem rowA40_cell_check (b : ℕ) (hb0 : 1 ≤ b) (hb1 : b ≤ 25) :
    cellCheck (2 ^ 40) (5 ^ b)
      (heightCap Stage01.H Stage01.M (2 ^ 40))
      (heightCap Stage01.H Stage01.M (5 ^ b)) Stage01.upper (rowA40 b) = true := by
  interval_cases b
  · simpa only [show rowA40 1 = cellA40B1 from rfl] using cellA40B1_check
  · simpa only [show rowA40 2 = cellA40B2 from rfl] using cellA40B2_check
  · simpa only [show rowA40 3 = cellA40B3 from rfl] using cellA40B3_check
  · simpa only [show rowA40 4 = cellA40B4 from rfl] using cellA40B4_check
