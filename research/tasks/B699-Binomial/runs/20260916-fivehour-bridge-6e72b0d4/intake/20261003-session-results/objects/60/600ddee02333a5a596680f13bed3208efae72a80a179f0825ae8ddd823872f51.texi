@item modQuotient: @ref{modQuotient}, see also: @ref{quotient}
@item modSat: @ref{modSat}, see also: @ref{sat}
@item modStd: @ref{modStd}, see also: @ref{std}, @ref{groebner}
@item pdf: @ref{pfd}
@item syModStd: @ref{syModStd}
