ring R=0,(r,t),dp;execute(read("/mnt/data/r7_work/H_polys.inc")); print("START"); poly E4=resultant(P5,V4,r); print("E4 DEG "+string(deg(E4))); write("/mnt/data/r7_work/H_E4.txt",string(E4)); poly E0=resultant(P5,V0,r);print("E0 DEG "+string(deg(E0)));write("/mnt/data/r7_work/H_E0.txt",string(E0));poly C=gcd(E4,E0);write("/mnt/data/r7_work/H_gcd.txt",string(C));print("GCD DEG "+string(deg(C))); list F=factorize(C); print(F);quit;