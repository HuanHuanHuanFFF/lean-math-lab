LEAD r**2*(4*sqrt(3) + 7)/192
b 6 7*r**2/192 sqrt3 coeff= r**2/48
b 5 35*r/64 sqrt3 coeff= 5*r/16
b 4 -7*(4*r**2 - 135)/384 sqrt3 coeff= -(4*r**2 - 135)/96
b 3 -45*(2*r**2 - 7)/(128*r) sqrt3 coeff= -5*(8*r**2 - 27)/(96*r)
b 2 3*(8*r**4 - 240*r**2 - 315)/(512*r**2) sqrt3 coeff= (8*r**4 - 360*r**2 - 405)/(384*r**2)
b 1 (80*r**4 + 180*r**2 + 1701)/(512*r**3) sqrt3 coeff= (40*r**4 + 729)/(384*r**3)
b 0 -(64*r**6 + 720*r**4 + 4860*r**2 + 25515)/(3072*r**4) sqrt3 coeff= -45*(4*r**2 + 27)/(256*r**4)
b0-bar 45*sqrt(3)*(-4*r**2 - 27)/(128*r**4)
Norm b0bar 6075*(4*r**2 + 27)**2/(16384*r**8)
