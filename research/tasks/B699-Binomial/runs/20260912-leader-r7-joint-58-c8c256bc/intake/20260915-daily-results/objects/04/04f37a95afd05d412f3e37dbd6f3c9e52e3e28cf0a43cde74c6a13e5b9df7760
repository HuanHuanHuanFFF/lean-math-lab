#!/usr/bin/env python3
"""Build the compact B699 R9 ABC context ZIP.

Only packet payload files and an optional caller-supplied extras directory are
read. Paths, sizes, and SHA-256 values are checked while bytes are streamed to
the output ZIP. No research file is imported or executed.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import stat
import sys
import tempfile
import zipfile

ROOT = Path(__file__).resolve().parent
SOURCES_PATH = ROOT / "PACKET_SOURCES.json"
MAX_MEMBER_BYTES = 64 * 1024 * 1024
MAX_SOURCES_JSON_BYTES = 8 * 1024 * 1024
MAX_EXTRA_TOTAL_BYTES = 256 * 1024 * 1024
CHUNK = 1024 * 1024
SHA_RE = re.compile(r"^[0-9a-fA-F]{64}$")
SHARED_REL = "shared/B699-R12-dispatch-context.zip"
FIXED_REL = (
    "PACKET_METADATA.json",
    "PACKET_SOURCES.json",
    "PACKAGING.md",
    "build_context.py",
    "prepare_context.py",
    SHARED_REL,
    "PACKET_BUILD.json",
)


class PacketError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise PacketError(message)


def safe_rel(value: str, *, label: str) -> str:
    if not isinstance(value, str) or not value or "\x00" in value:
        fail(f"unsafe {label}")
    if "\\" in value or "//" in value:
        fail(f"unsafe {label}: {value!r}")
    if value.startswith("/"):
        fail(f"absolute {label}: {value!r}")
    path = PurePosixPath(value)
    if path.is_absolute() or any(part in ("", ".", "..") for part in path.parts):
        fail(f"unsafe {label}: {value!r}")
    return "/".join(path.parts)


def reject_symlink_components(path: Path, *, root: Path) -> None:
    try:
        relative = path.relative_to(root)
    except ValueError:
        fail(f"path outside controlled root: {path}")
    current = root
    for part in relative.parts:
        current = current / part
        try:
            mode = current.lstat().st_mode
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(mode):
            fail(f"symlink component rejected: {current}")


def packet_path(value: str, *, label: str) -> Path:
    relative = safe_rel(value, label=label)
    path = ROOT.joinpath(*relative.split("/"))
    root_resolved = ROOT.resolve()
    path_resolved = path.resolve()
    if path_resolved != root_resolved and root_resolved not in path_resolved.parents:
        fail(f"packet path escapes root: {value!r}")
    reject_symlink_components(path, root=ROOT)
    return path


def regular_file(path: Path, *, label: str, root: Path = ROOT, max_bytes: int = MAX_MEMBER_BYTES) -> os.stat_result:
    reject_symlink_components(path, root=root)
    try:
        st = path.lstat()
    except FileNotFoundError:
        fail(f"missing {label}: {path}")
    if not stat.S_ISREG(st.st_mode):
        fail(f"non-regular {label}: {path}")
    if st.st_size > max_bytes:
        fail(f"{label} too large: {st.st_size}")
    return st


def checked_sha(value: object, *, label: str) -> str:
    text = str(value)
    if not SHA_RE.fullmatch(text):
        fail(f"invalid SHA-256 for {label}")
    return text.lower()


def sha256_file(path: Path) -> tuple[int, str]:
    digest = hashlib.sha256()
    total = 0
    with path.open("rb") as stream:
        while True:
            block = stream.read(CHUNK)
            if not block:
                break
            total += len(block)
            digest.update(block)
    return total, digest.hexdigest()


def load_sources() -> dict:
    regular_file(SOURCES_PATH, label="PACKET_SOURCES.json", max_bytes=MAX_SOURCES_JSON_BYTES)
    try:
        data = json.loads(SOURCES_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        fail(f"cannot read PACKET_SOURCES.json: {exc}")
    if not isinstance(data, dict) or data.get("schema") != "b699-r9-abc-context-sources-v1":
        fail("unsupported PACKET_SOURCES.json schema")
    archives = data.get("archives")
    if not isinstance(archives, dict) or set(archives) != {"pro-a", "pro-b"}:
        fail("archives must contain exactly pro-a and pro-b")
    return data


def scan_files(directory: Path, *, label: str, root: Path, max_total: int | None = None) -> tuple[dict[str, Path], int]:
    if directory.is_symlink() or not directory.exists() or not directory.is_dir():
        fail(f"{label} is not a regular directory: {directory}")
    found: dict[str, Path] = {}
    total = 0

    def visit(current: Path, relative: PurePosixPath) -> None:
        nonlocal total
        try:
            entries = list(os.scandir(current))
        except OSError as exc:
            fail(f"cannot scan {label}: {exc}")
        for entry in entries:
            path = Path(entry.path)
            rel = relative / entry.name
            rel_s = safe_rel(rel.as_posix(), label=f"{label} member")
            try:
                st = path.lstat()
            except OSError as exc:
                fail(f"cannot stat {label} member {rel_s}: {exc}")
            if stat.S_ISLNK(st.st_mode):
                fail(f"symlink {label} member rejected: {rel_s}")
            if stat.S_ISDIR(st.st_mode):
                visit(path, PurePosixPath(rel_s))
            elif stat.S_ISREG(st.st_mode):
                if st.st_size > MAX_MEMBER_BYTES:
                    fail(f"{label} member too large: {rel_s}")
                if rel_s in found:
                    fail(f"duplicate {label} member: {rel_s}")
                total += st.st_size
                if max_total is not None and total > max_total:
                    fail(f"{label} exceeds total size bound")
                found[rel_s] = path
            else:
                fail(f"unsupported {label} node: {rel_s}")

    visit(directory, PurePosixPath())
    return found, total


def validate_packet(data: dict) -> dict[str, dict]:
    shared_meta = data.get("shared")
    if not isinstance(shared_meta, dict):
        fail("shared metadata missing")
    shared_rel = safe_rel(shared_meta.get("path"), label="shared path")
    if shared_rel != SHARED_REL:
        fail(f"unexpected shared path: {shared_rel}")
    shared_size = int(shared_meta.get("size", -1))
    shared_sha = checked_sha(shared_meta.get("sha256"), label="shared ZIP")
    shared_path = packet_path(shared_rel, label="shared ZIP")
    st = regular_file(shared_path, label="shared ZIP")
    if st.st_size != shared_size:
        fail(f"shared ZIP size mismatch: {st.st_size} != {shared_size}")
    actual_size, actual_sha = sha256_file(shared_path)
    if (actual_size, actual_sha) != (shared_size, shared_sha):
        fail(f"shared ZIP SHA-256 mismatch: {actual_sha} != {shared_sha}")

    expected: dict[str, dict] = {}
    total_declared = 0
    for archive_id in ("pro-a", "pro-b"):
        archive = data["archives"][archive_id]
        if not isinstance(archive, dict) or not isinstance(archive.get("members"), list):
            fail(f"invalid member map for {archive_id}")
        root_prefix = archive.get("root_prefix")
        if root_prefix is not None:
            root_prefix = safe_rel(str(root_prefix), label=f"{archive_id} root prefix")
        safe_rel(str(archive.get("restore_root", archive_id)), label=f"{archive_id} restore root")
        source_names: set[str] = set()
        restore_names: set[str] = set()
        stored_count = 0
        omitted_count = 0
        for member in archive["members"]:
            if not isinstance(member, dict):
                fail(f"invalid member entry in {archive_id}")
            source_name = safe_rel(member.get("source_member"), label=f"{archive_id} source member")
            relative_name = safe_rel(member.get("relative_member"), label=f"{archive_id} relative member")
            restore_name = safe_rel(member.get("restore_path"), label=f"{archive_id} restore path")
            if source_name in source_names or restore_name in restore_names:
                fail(f"duplicate member mapping in {archive_id}: {source_name}")
            source_names.add(source_name)
            restore_names.add(restore_name)
            if root_prefix is None:
                if source_name != relative_name:
                    fail(f"relative member mismatch in {archive_id}: {source_name}")
            elif not source_name.startswith(root_prefix + "/") or source_name[len(root_prefix) + 1:] != relative_name:
                fail(f"root stripping mismatch in {archive_id}: {source_name}")
            size = int(member.get("size", -1))
            if size < 0 or size > MAX_MEMBER_BYTES:
                fail(f"invalid member size in {archive_id}: {source_name}")
            sha = checked_sha(member.get("sha256"), label=f"{archive_id}:{source_name}")
            total_declared += size
            if total_declared > MAX_EXTRA_TOTAL_BYTES * 2:
                fail("declared packet payload exceeds bound")
            storage = member.get("storage")
            if not isinstance(storage, dict):
                fail(f"missing storage map in {archive_id}: {source_name}")
            kind = storage.get("kind")
            if kind == "packet-file":
                path_rel = safe_rel(storage.get("path"), label=f"{archive_id} packet storage")
                expected_prefix = f"sources/{archive_id}/"
                if not path_rel.startswith(expected_prefix) or path_rel[len(expected_prefix):] != relative_name:
                    fail(f"packet storage mismatch in {archive_id}: {source_name}")
                if path_rel in expected:
                    fail(f"duplicate packet storage path: {path_rel}")
                expected[path_rel] = {"size": size, "sha256": sha, "label": f"{archive_id}:{source_name}"}
                stored_count += 1
            elif kind == "shared-file":
                if safe_rel(storage.get("path"), label="shared storage") != SHARED_REL:
                    fail(f"unexpected shared storage path: {archive_id}:{source_name}")
                if size != shared_size or sha != shared_sha:
                    fail(f"shared nested bytes mismatch: {archive_id}:{source_name}")
                omitted_count += 1
            else:
                fail(f"unknown storage kind {kind!r} in {archive_id}")
        if stored_count != int(archive.get("stored_member_count", -1)):
            fail(f"stored member count mismatch for {archive_id}")
        if omitted_count != int(archive.get("omitted_member_count", -1)):
            fail(f"omitted member count mismatch for {archive_id}")
        if len(archive["members"]) != int(archive.get("member_count", -1)):
            fail(f"member count mismatch for {archive_id}")
        if omitted_count != 1:
            fail(f"expected one omitted nested ZIP for {archive_id}")

    for archive_id in ("pro-a", "pro-b"):
        root_rel = f"sources/{archive_id}"
        root = packet_path(root_rel, label=root_rel)
        actual, _ = scan_files(root, label=root_rel, root=ROOT)
        actual_rel = {f"{root_rel}/{name}" for name in actual}
        expected_rel = {name for name in expected if name.startswith(f"{root_rel}/")}
        if actual_rel != expected_rel:
            missing = sorted(expected_rel - actual_rel)[:3]
            extra = sorted(actual_rel - expected_rel)[:3]
            fail(f"packet tree mismatch {archive_id}: missing={missing} extra={extra}")
    for path_rel, expected_entry in expected.items():
        path = packet_path(path_rel, label=path_rel)
        st = regular_file(path, label=expected_entry["label"])
        if st.st_size != expected_entry["size"]:
            fail(f"packet member size mismatch: {path_rel}")
        actual_size, actual_sha = sha256_file(path)
        if (actual_size, actual_sha) != (expected_entry["size"], expected_entry["sha256"]):
            fail(f"packet member SHA-256 mismatch: {path_rel}")
    return expected


def extras_files(extras: Path | None) -> tuple[list[tuple[str, Path]], int]:
    if extras is None:
        candidate = ROOT / "extras"
        if candidate.exists():
            extras = candidate
        else:
            return [], 0
    extras = extras.expanduser()
    if extras.is_symlink() or not extras.exists() or not extras.is_dir():
        fail(f"extras is not a regular directory: {extras}")
    if extras.resolve() == ROOT.resolve():
        fail("extras cannot be the packet root")
    found, total = scan_files(extras, label="extras", root=extras, max_total=MAX_EXTRA_TOTAL_BYTES)
    return [(name, found[name]) for name in sorted(found)], total


def collision_check(paths: list[str]) -> None:
    seen: set[str] = set()
    for path in paths:
        path = safe_rel(path, label="archive member")
        if path in seen:
            fail(f"unexpected overwrite collision: {path}")
        # A file may not be both an ancestor and a descendant of another file.
        parts = path.split("/")
        for index in range(1, len(parts)):
            if "/".join(parts[:index]) in seen:
                fail(f"unexpected overwrite collision: {path}")
        if any(existing.startswith(path + "/") for existing in seen):
            fail(f"unexpected overwrite collision: {path}")
        seen.add(path)


def zip_info(arcname: str, *, stored: bool = False) -> zipfile.ZipInfo:
    info = zipfile.ZipInfo(arcname, date_time=(1980, 1, 1, 0, 0, 0))
    info.create_system = 3
    info.external_attr = 0o100644 << 16
    info.compress_type = zipfile.ZIP_STORED if stored else zipfile.ZIP_DEFLATED
    return info


def add_path(zf: zipfile.ZipFile, path: Path, arcname: str, *, stored: bool = False, expected: dict | None = None) -> tuple[int, str]:
    safe_rel(arcname, label="output archive member")
    st = regular_file(path, label=f"archive input {arcname}", root=path.parent if path.parent == ROOT else path.parent)
    expected_size = st.st_size if expected is None else int(expected["size"])
    expected_sha = None if expected is None else str(expected["sha256"])
    if st.st_size != expected_size:
        fail(f"source size changed before archiving: {arcname}")
    digest = hashlib.sha256()
    written = 0
    info = zip_info(arcname, stored=stored)
    try:
        with path.open("rb") as source, zf.open(info, "w") as target:
            while True:
                block = source.read(CHUNK)
                if not block:
                    break
                target.write(block)
                digest.update(block)
                written += len(block)
    except OSError as exc:
        fail(f"cannot archive {arcname}: {exc}")
    actual_sha = digest.hexdigest()
    if written != expected_size:
        fail(f"source changed while archiving: {arcname}")
    if expected_sha is not None and actual_sha != expected_sha:
        fail(f"source SHA-256 changed while archiving: {arcname}")
    return written, actual_sha


def sha256_output(path: Path) -> str:
    return sha256_file(path)[1]


def build(data: dict, output: Path, extras_arg: Path | None) -> dict:
    payload = validate_packet(data)
    extras, extras_bytes = extras_files(extras_arg)
    core_paths = list(FIXED_REL[:-1]) + sorted(payload)
    extra_names = [name for name, _ in extras]
    collision_check(core_paths + extra_names + [FIXED_REL[-1]])
    if any(name.startswith("sources/") or name.startswith("shared/") for name in extra_names):
        # Such entries are valid paths in isolation but can hide payload; keep
        # the collision rule explicit for future packet layouts.
        fail("extras may not write under sources/ or shared/")

    fixed_files = [
        ("PACKET_METADATA.json", ROOT / "PACKET_METADATA.json", False, None),
        ("PACKET_SOURCES.json", ROOT / "PACKET_SOURCES.json", False, None),
        ("PACKAGING.md", ROOT / "PACKAGING.md", False, None),
        ("build_context.py", ROOT / "build_context.py", False, None),
        ("prepare_context.py", ROOT / "prepare_context.py", False, None),
        (SHARED_REL, packet_path(SHARED_REL, label="shared ZIP"), True, {"size": int(data["shared"]["size"]), "sha256": checked_sha(data["shared"]["sha256"], label="shared ZIP")}),
    ]
    output = output.expanduser()
    if output.exists() and output.is_symlink():
        fail(f"output symlink rejected: {output}")
    output.parent.mkdir(parents=True, exist_ok=True)
    descriptor_count = 0
    descriptor_bytes = 0
    temporary: Path | None = None
    try:
        fd, name = tempfile.mkstemp(prefix=f".{output.name}.", suffix=".tmp", dir=str(output.parent))
        os.close(fd)
        temporary = Path(name)
        with zipfile.ZipFile(temporary, "w", compression=zipfile.ZIP_DEFLATED, allowZip64=True) as zf:
            for arcname, path, stored, expected in fixed_files:
                n, _ = add_path(zf, path, arcname, stored=stored, expected=expected)
                descriptor_count += 1
                descriptor_bytes += n
            for arcname in sorted(payload):
                n, _ = add_path(zf, packet_path(arcname, label=arcname), arcname, expected=payload[arcname])
                descriptor_count += 1
                descriptor_bytes += n
            for arcname, path in extras:
                n, _ = add_path(zf, path, arcname)
                descriptor_count += 1
                descriptor_bytes += n
            record = {
                "schema": "b699-r9-abc-context-build-v1",
                "packet_members": descriptor_count,
                "extras_members": len(extras),
                "extras_paths": [name for name, _ in extras],
                "uncompressed_payload_bytes_before_record": descriptor_bytes,
                "shared_zip_storage": "stored",
                "outer_archives_omitted": ["pro-a", "pro-b"],
                "outer_archives_reconstructed": False,
                "code_execution": False,
            }
            record_bytes = (json.dumps(record, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")
            zf.writestr(zip_info("PACKET_BUILD.json"), record_bytes)
            descriptor_count += 1
            descriptor_bytes += len(record_bytes)
        os.replace(temporary, output)
        temporary = None
    finally:
        if temporary is not None:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass
    return {
        "status": "ok",
        "output": str(output),
        "archive_bytes": output.stat().st_size,
        "archive_sha256": sha256_output(output),
        "members": descriptor_count,
        "packet_payload_members": len(payload),
        "extras_members": len(extras),
        "extras_uncompressed_bytes": extras_bytes,
        "uncompressed_payload_bytes": descriptor_bytes,
        "outer_archives_reconstructed": False,
        "code_execution": False,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Build the B699 R9 ABC context ZIP")
    parser.add_argument("--extras", "--extra-dir", dest="extras", type=Path, default=None, help="optional directory whose files are added at ZIP root")
    parser.add_argument("--output", type=Path, default=ROOT.parent.parent / "deliverables" / "B699-R9-ABC-context.zip", help="output ZIP path")
    args = parser.parse_args(argv)
    try:
        result = build(load_sources(), args.output, args.extras)
        print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
        return 0
    except (PacketError, OSError, ValueError, KeyError, TypeError, zipfile.BadZipFile) as exc:
        print(json.dumps({"status": "error", "error": str(exc)}, ensure_ascii=False, separators=(",", ":")), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
