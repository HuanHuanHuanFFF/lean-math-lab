import math,json,time
from pathlib import Path
LIMIT=50000; t0=time.monotonic();NMAX=2*LIMIT+2
spf=list(range(NMAX+1))
for p in range(2,math.isqrt(NMAX)+1):
 if spf[p]==p:
  for m in range(p*p,NMAX+1,p):
   if spf[m]==m:spf[m]=p

def factors(n):
 d={}
 while n>1:
  p=spf[n];d[p]=d.get(p,0)+1;n//=p
 return d
hits=[];proj=[];divcount=0
for k in range(1,LIMIT+1):
 ff=factors(2*k-1)
 for p,e in factors(2*k+1).items():ff[p]=ff.get(p,0)+e
 dd=[1]
 for p,e in ff.items():dd=[d*p**a for d in dd for a in range(e+1)]
 for u in dd:
  divcount+=1;n=2*u+2;t=4*k+1;d2=t*(n-1)+1;d=math.isqrt(d2)
  if d*d!=d2 or (n-d)%2:continue
  j=(n-d)//2
  if not 4<=j<=n//2:continue
  if j*(j-1)%(n-1):continue
  q=j*(j-1)//(n-1)
  row=[n,j,t,q]
  proj.append(row)
  if q*(j-2)%(n-2)==0:hits.append(row)
out={'scope':'central t=4k+1,1<=k<=50000; diagnostic, not global','divisors_tested':divcount,'projected_candidates':proj,'exact_moments_hits':hits,'seconds':time.monotonic()-t0}
p=Path(__file__).resolve().parents[1]/'evidence/exact_moments_probe.json';p.write_text(json.dumps(out,indent=2))
print({'projected':len(proj),'exact_hits':len(hits),'samples':hits[:12],'divisors':divcount,'seconds':out['seconds']})
