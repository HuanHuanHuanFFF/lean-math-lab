#!/usr/bin/env python3
"""Generate finite certificates from frozen discovery factors; no search oracle."""
from __future__ import annotations
import argparse, json, math
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]

def save(p:Path,data:object)->None:
    p.parent.mkdir(parents=True,exist_ok=True)
    p.write_text(json.dumps(data,sort_keys=True,indent=2,ensure_ascii=False)+'\n')

def valuation(n:int,p:int)->int:
    if n<=0: raise ValueError('positive valuation argument required')
    a=0
    while n%p==0: n//=p; a+=1
    return a

def digital_rows(factors:dict)->dict:
    rows=[];candidates=[]
    wanted=[v for v in range(3,113) if v<=56 or v%6 in (2,4)]
    if sorted(map(int,factors))!=wanted:raise ValueError('factor-row coverage')
    for v in wanted:
        n=1<<v; lam=3 if v%6 in (2,4) else 1;N=(n-1)//lam
        fac=factors[str(v)];roots=[0];mod=1
        for p,e in fac:
            if p<2 or e<1:raise ValueError('invalid factor')
            q=p**e
            if math.gcd(mod,q)!=1:raise ValueError('noncoprime prime-power groups')
            inv=pow(mod,-1,q)
            roots=[r+mod*((b-r)*inv%q) for r in roots for b in (0,1)]
            mod*=q
        if mod!=N:raise ValueError('incomplete product')
        chosen=[]
        for r in roots:
            lo=max(0,(4-r+N-1)//N); hi=(n//2-r)//N
            for k in range(lo,hi+1):
                j=r+k*N;w=j.bit_count();t=valuation(j,2)
                if not (w<=3 or (j%2==1 and w<=8)):continue
                d=(lam*((1<<t)-1)).bit_count()
                if v>lam.bit_count()*w*(w-1)+w*d or v<4*t-1:continue
                rec={'v':v,'n':n,'j':j,'t':t,'weight':w,
                     'second_remainder':6*j*(j-1)*(j-2)%(n-2)}
                chosen.append(rec);candidates.append(rec)
        rows.append({'v':v,'lambda':lam,'N':N,'factors':fac,'crt_roots':len(roots),
                     'retained':sorted(chosen,key=lambda x:x['j'])})
    candidates.sort(key=lambda x:(x['v'],x['j']))
    return {'schema':'B699-digital-v3-v1','all_weight':3,'odd_weight':8,
            'rows':rows,'candidates':candidates,
            'summary':{'rows':len(rows),'crt_roots':sum(r['crt_roots']for r in rows),
                       'candidates':len(candidates),'survivors':sum(r['second_remainder']==0 for r in candidates)}}

def geometric_rows()->dict:
    rows=[]
    for k,bound in [(4,128),(5,18),(6,8)]:
        for x in range(k,bound,k):
            if x%2:continue
            n=x**k;S=sum(x**h for h in range(k));j=x*S//k
            if x*S%k:raise ValueError('nonintegral j')
            R=6*x*((k-1)*x-k)*((2*k-1)*x-2*k)
            rows.append({'degree':k,'base':x,'n':n,'j':j,
                         'first_remainder':j*(j-1)%(n-1),
                         'second_remainder':6*j*(j-1)*(j-2)%(n-2),
                         'eliminant':R,'eliminant_remainder':R%(n-2)})
    return {'schema':'B699-cyclic-family-v1','rows':rows,'summary':{'rows':len(rows),'survivors':sum(r['second_remainder']==0 for r in rows)}}

def main()->None:
    ap=argparse.ArgumentParser();ap.add_argument('--output',type=Path,required=True);args=ap.parse_args()
    factors=json.loads((ROOT/'sources/factor_seed.json').read_text())
    save(args.output/'digital_certificate.json',digital_rows(factors))
    save(args.output/'cyclic_certificate.json',geometric_rows())
    print('GENERATED digital and cyclic certificates')
if __name__=='__main__':main()
