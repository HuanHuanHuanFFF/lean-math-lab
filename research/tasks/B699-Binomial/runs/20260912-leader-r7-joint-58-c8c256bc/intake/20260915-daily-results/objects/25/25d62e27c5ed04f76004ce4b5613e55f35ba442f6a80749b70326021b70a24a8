#!/usr/bin/env python3
"""Fail-closed byte manifest check. Runtime receipts are under replay/ only."""
from __future__ import annotations
import hashlib
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()

def static_files(root: Path) -> dict[str, Path]:
    result = {}
    for path in root.rglob('*'):
        if not path.is_file():
            continue
        rel = path.relative_to(root)
        if rel.parts[0] == 'replay' or '__pycache__' in rel.parts or rel.name == 'MANIFEST.json' and len(rel.parts) == 1:
            continue
        if path.is_symlink():
            raise ValueError(f'symlink is not accepted: {rel}')
        result[rel.as_posix()] = path
    return result

def verify(root: Path = ROOT) -> dict[str, object]:
    data = json.loads((root / 'MANIFEST.json').read_text(encoding='utf-8'))
    if data.get('schema') != 'B699-ProB-v3-static-manifest-1':
        raise ValueError('manifest schema')
    entries = data['files']
    expected = {row['path']: row for row in entries}
    if len(expected) != len(entries):
        raise ValueError('duplicate manifest entry')
    actual = static_files(root)
    if set(actual) != set(expected):
        raise ValueError(f'file coverage differs: missing={sorted(set(expected)-set(actual))}; extra={sorted(set(actual)-set(expected))}')
    for rel, path in actual.items():
        row = expected[rel]
        if path.stat().st_size != row['bytes'] or digest(path) != row['sha256']:
            raise ValueError(f'file byte mismatch: {rel}')
    return {'status': 'PASS_BYTES_ONLY', 'static_files': len(actual),
            'manifest_sha256': digest(root / 'MANIFEST.json')}

if __name__ == '__main__':
    try:
        print(json.dumps(verify(), ensure_ascii=False, sort_keys=True))
    except (OSError, ValueError, KeyError, TypeError) as exc:
        print(f'MANIFEST REJECTED: {exc}', file=sys.stderr)
        raise SystemExit(1)
