from pathlib import Path
import hashlib,json
r=Path(__file__).resolve().parent
m=json.loads((r/'SOURCE_REVISION.json').read_text())
for n,v in m['members'].items():
 p=r/n
 h=hashlib.sha256()
 with p.open('rb') as f:
  for b in iter(lambda:f.read(1048576),b''):h.update(b)
 if p.stat().st_size!=v['bytes'] or h.hexdigest()!=v['sha256']:
  raise SystemExit('FAIL: '+n)
print('PASS: '+str(len(m['members']))+' members; file bytes only, not mathematics')
