"""Finite regression diagnostics; these do NOT prove any infinite consumer.

They use integer binomial recurrence, full prime powers, direct product
checks, and tiny brute-force congruence sets. All test limits are recorded.
"""
from __future__ import annotations
import argparse
import itertools
import json
import math
import time
from collections import Counter
from pathlib import Path
from verify import SMALL, SUPPORT, need, kernel_stages, affine_origin, determinant, inverse, dot, eye


def strip(n, primes):
    for p in primes:
        while n % p == 0:
            n //= p
    return n


def vp_binomial(n,j,p):
    # Independent Legendre floor sum, not an integer binomial computation.
    s=0; q=p
    while q<=n:
        s+=n//q-j//q-(n-j)//q
        q*=p
    return s


def run():
    start=time.perf_counter(); count=Counter()
    # Direct C(n,j) recurrence; the proof never relies on this finite test.
    for n in range(20,513):
        source=math.comb(n,9); v=strip(source,SMALL); target=1
        qs=[]
        for p in SMALL:
            best=1
            for r in range(9):
                a=n-r; q=1
                while a%p==0:a//=p;q*=p
                best=max(best,q)
            qs.append(best)
        need(9*(source//v)<=math.prod(qs),'DIAG_SOURCE_SMOOTH_BOUND')
        count['source_smooth_bound_n']+=1
        for j in range(1,n//2+1):
            target=target*(n-j+1)//j
            if j<10:continue
            if strip(math.gcd(n,j),SUPPORT)==1:
                need(math.gcd(v,target)>1,'DIAG_SMOOTH_GCD_CONSUMER')
                count['consumer_legal_pairs']+=1
            if n<=160:
                d=v
                while (c:=math.gcd(d,target))>1:d//=c
                t=math.prod(math.comb(n-9+h,h)*math.comb(j,h)*math.comb(n-j,h) for h in range(1,7))
                need(t%pow(d,10)==0,'DIAG_AVOIDING_FULL_POWER_PRODUCT')
                count['avoiding_product_pairs']+=1
                count['nontrivial_avoiding_product_pairs']+=int(d>1)
    for p in SUPPORT[4:]:
        for e in range(1,9):
            q=p**e
            for a in range(1,17):
                if a%p==0:continue  # p^e exactly divides n.
                n=q*a
                js=sorted({10,11,12,q-1,q,q+1,2*q,2*q+1,n//2,n//2-1})
                for j in js:
                    if not 10<=j<=n//2:continue
                    w=vp_binomial(n,j,p)
                    if w==0:
                        need(j%q==0,'DIAG_ROW0_COMPLETE_POWER')
                        count['row0_avoiding_cases']+=1
                    count['row0_prime_power_cases']+=1
                    if j%q==0 and w>0:count['upper_carry_not_erased_cases']+=1
    # Exhaust every right side and every tiny x for four independent systems.
    systems=[([[1,2],[3,1]],[4,5]), ([[0,0],[2,4]],[3,6]),
             ([[1,2,3],[2,0,1]],[3,4]), ([[0,0,0],[6,4,2]],[2,4])]
    for rows,mods in systems:
        stages,index=kernel_stages(rows,mods);d=len(rows[0])
        # A direct kernel basis is reconstructed by accumulating the same
        # homogeneous stages, then checked by an independent enumeration.
        basis=eye(d)
        # Kernel need not be built explicitly: a particular origin exists
        # exactly when one of the full residue-period candidates exists.
        period=math.lcm(*mods)
        vectors=list(itertools.product(range(period),repeat=d))
        observed={tuple(dot(row,x)%m for row,m in zip(rows,mods)) for x in vectors}
        need(period**d//len(observed)==index,'DIAG_KERNEL_INDEX_BY_ENUMERATION')
        for rhs in itertools.product(*(range(m) for m in mods)):
            origin=affine_origin(stages,list(rhs))
            need((origin is not None)==(rhs in observed),'DIAG_AFFINE_EXISTENCE_BY_ENUMERATION')
            if origin is not None:
                need(all(dot(row,origin)%m==b for row,m,b in zip(rows,mods,rhs)), 'DIAG_ORIGIN_CONGRUENCE')
            count['toy_rhs_cases']+=1
        count['toy_congruence_vectors']+=len(vectors)
    return {'status':'PASS_FINITE_REGRESSIONS_NOT_AN_INFINITE_PROOF','seconds':time.perf_counter()-start,
            'counts':dict(sorted(count.items())),
            'ranges':{'consumer_n':[20,512], 'avoiding_product_n':[20,160],
                      'full_prime_power_exponents':[1,8], 'full_prime_power_cofactors':[1,16]},
            'historical_certificates_replayed':False,'lean':False}


def main():
    p=argparse.ArgumentParser(description=__doc__);p.add_argument('--out',type=Path)
    a=p.parse_args();out=a.out or Path(__file__).resolve().parents[1]/'logs/diagnostics.json'
    out.parent.mkdir(parents=True,exist_ok=True);result=run()
    out.write_text(json.dumps(result,indent=2));print(json.dumps(result,indent=2))

if __name__=='__main__':main()
