from math import gcd
from collections import defaultdict

def primes(n):
 return [p for p in range(3,n+1,2) if all(p%d for d in range(2,1+int(p**.5)))]

def local(B,z,V,ell,lam,mu,g,c,L=360):
 # H integer, C=(2H+z)/ell; here V=ell=lam=mu=z=1
 assert V==ell==lam==mu==z==1
 e=B-3
 survivors=set(range(L)); killers=[]
 for p in [p for p in primes(1000) if pow(2,L,p)==1]:
  square={k*k%p for k in range(p)}
  good_n=set()
  for h in range(p):
   if p%3==0: pass
   if g%p==0 and h!=0:continue
   C=(2*h+1)%p
   U=(B*h-1)%p
   F=(B+4*U*(h+1))%p
   n=(2*C*F+2)%p
   # cubic y² direct polynomial in h
   val=(8*B*B*h**3+(12*B*B-16*B)*h*h+(6*B*B-21*B+8)*h+B*B-6*B+9)%p
   if val in square:
    good_n.add(n)
  kill={r for r in survivors if c*g*pow(2,r,p)%p not in good_n}
  if kill:killers.append((p,len(kill)));survivors-=kill
  if not survivors:break
 return sorted(survivors),killers
for B in [1,5,7,11,13,17,19,23,25,29,31,35]:
 e=abs(B-3)
 gs=[g for g in range(1,e+1) if e%g==0 and g%2]
 z=1
 summary=[]
 for g in gs:
  for c in [1,3]:
   if c==3 and g%3==0: continue
   surv,kills=local(B,1,1,1,1,1,g,c)
   # enforce lam=mu=1 mod9
   surv=[r for r in surv if (c*g*pow(2,r,9))%9 in [0,1,2,3,6]]
   summary.append((g,c,len(surv),surv[:10],kills))
 print(B,summary)
