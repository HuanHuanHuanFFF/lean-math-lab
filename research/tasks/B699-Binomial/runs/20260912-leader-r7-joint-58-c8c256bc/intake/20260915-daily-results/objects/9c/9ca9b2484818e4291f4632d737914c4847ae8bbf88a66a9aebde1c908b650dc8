"""Exact polynomial checks for the two defect cubics and discarded models."""
import sys,json
from pathlib import Path
from fractions import Fraction
from poly import const,var,add,mul,power,scale,sub,disc3,evaluate

def run():
    checks=[]
    # Variable order H,z,Q,V, with X=2H+z.
    H,z,Q,V=[var(i,4) for i in range(4)];X=add(scale(H,2),z)
    P=add(scale(mul(Q,power(X,3)),2),scale(mul(V,power(X,2)),-4),scale(mul(V,z,X),-4),scale(mul(V,power(z,2)),2))
    expected=add(scale(mul(Q,power(H,3)),16),mul(add(scale(mul(Q,z),24),scale(V,-16)),power(H,2)),mul(add(scale(mul(Q,power(z,2)),12),scale(mul(V,z),-24)),H),scale(mul(Q,power(z,3)),2),scale(mul(V,power(z,2)),-6))
    assert P==expected;checks.append('old-cubic-to-X-cubic')
    disc=disc3(scale(Q,2),scale(V,-4),scale(mul(V,z),-4),scale(mul(V,power(z,2)),2))
    B=mul(Q,z)
    exp=scale(mul(power(V,2),power(z,2),add(scale(power(B,2),27),scale(mul(V,B),-104),scale(power(V,2),-48))),-16)
    assert disc==exp;checks.append('X-cubic-discriminant')
    C,Q,z=[var(i,3) for i in range(3)]
    for lam,mu in [(1,1),(1,3),(3,1)]:
        ell=lam*mu;V=lam*ell*ell
        Fn=add(mul(Q,power(C,2)),scale(C,-2*lam*ell),scale(z,-2*lam))
        Un=add(mul(sub(scale(C,ell),z),Q),const(-2*V,3))
        co=[scale(power(Q,2),2*mu),scale(Q,-8*ell*ell),scale(add(const(8*V,3),scale(mul(Q,z),-5)),ell),add(mul(Q,power(z,2)),scale(z,10*V))]
        f=add(mul(co[0],power(C,3)),mul(co[1],power(C,2)),mul(co[2],C),co[3])
        cleared=sub(scale(power(Fn,2),2*lam*mu*mu),mul(Un,add(scale(mul(C,Fn),2*mu),power(z,2))))
        assert cleared==mul(z,f);checks.append(f'elliptic-square-elimination-{lam}-{mu}')
        d=disc3(*co);B=mul(Q,z)
        ex=scale(mul(power(Q,4),power(z,2),add(scale(power(B,2),27),scale(B,-70*V),const(-36*V*V,3))),-4*mu*mu)
        assert d==ex;checks.append(f'elliptic-discriminant-{lam}-{mu}')
    # Integer discriminant square obstructions, valid as polynomial identities.
    B,V=var(0),var(1)
    assert scale(add(scale(power(B,2),27),scale(mul(B,V),-104),scale(power(V,2),-48)),27)==sub(power(sub(scale(B,27),scale(V,52)),2),scale(power(V,2),4000))
    assert scale(add(scale(power(B,2),27),scale(mul(B,V),-70),scale(power(V,2),-36)),27)==sub(power(sub(scale(B,27),scale(V,35)),2),scale(power(V,2),2197))
    checks+=['nonzero-discriminant-4000','nonzero-discriminant-2197']
    # Scalar CG has infinitely many fake reconstructions without the same-j square.
    h=var(0,1);one=const(1,1);C=add(scale(h,2),one);U=add(scale(h,29),const(-1,1));F=add(scale(power(h,2),116),scale(h,112),const(25,1));n=add(scale(mul(C,F),2),const(2,1))
    assert sub(mul(h,F),mul(U,power(C,2)))==one
    assert sub(scale(mul(n,h),Fraction(1,2)),add(mul(U,power(C,3)),C,h))=={}
    y2=sub(power(F,2),mul(U,add(n,const(-1,1))))
    assert y2==add(scale(power(h,3),6728),scale(power(h,2),9628),scale(h,4445),const(676,1))
    checks+=['fake-CG-family-identities','fake-CG-square-polynomial']
    for t in range(12):
        hv=221+360*t;nv=int(evaluate(n,[hv]));yv=int(evaluate(y2,[hv]))
        assert nv%4==0 and nv%9==1 and yv%5==2
    # Fixed exponent substitutions in BEG 2.1; no publication theorem is checked here.
    assert 14*3**3*3**3==10206 and 8*3**2*3**3==1944
    bound_records=[]
    for b in [1,29,1000]:
        A=18**10206*(512*(b+81)**3)**1944
        assert A>12*(b+81)
        assert 8*A<2**68529*(b+81)**5832
        bound_records.append({'defect_bound':b,'outer_exponent_8A_bits':(8*A).bit_length()})
    return {'status':'PASS','symbolic_identities':len(checks),'identities':checks,'fake_family_instances':12,'BEG_exponent_substitution':[10206,1944],'height_scale_diagnostics':bound_records,'scope':'identity and arithmetic check; not a proof of the external theorem'}
if __name__=='__main__':
    r=run();Path(sys.argv[1]).write_text(json.dumps(r,sort_keys=True,indent=2)+'\n');print(json.dumps(r))
