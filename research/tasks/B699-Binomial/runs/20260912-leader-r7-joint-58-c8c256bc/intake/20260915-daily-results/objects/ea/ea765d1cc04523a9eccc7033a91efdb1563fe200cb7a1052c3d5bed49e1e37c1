#!/usr/bin/env python3
"""Bounded diagnostic only: full window prime powers versus all carry layers."""
import json, time
from pathlib import Path
N=20000
start=time.perf_counter()
spf=list(range(N+1))
for p in range(2,int(N**.5)+1):
 if spf[p]==p:
  for k in range(p*p,N+1,p):
   if spf[k]==k: spf[k]=p

def factors(x):
 out=[]
 while x>1:
  p=spf[x];q=1
  while x%p==0:x//=p;q*=p
  if p>=11:out.append((p,q))
 return out

def carries(n,j,p):
 z=0;M=p
 while M<=n:
  z+=(j%M>n%M);M*=p
 return z

surv=[];tested=0;original_nc=[]
for n in range(20,N+1):
 cs=[(p,q,r) for r in range(9) for p,q in factors(n-r)]
 p,q,r=min(cs,key=lambda x:(x[2]+1)/x[1])
 for b in range(r+1):
  k0=max(0,(10-b+q-1)//q)
  for j in range(b+k0*q,n//2+1,q):
   tested+=1
   if not all(j%qq<=rr for pp,qq,rr in cs):continue
   c=[(pp,qq,rr,carries(n,j,pp)) for pp,qq,rr in cs if carries(n,j,pp)]
   if len(surv)<30:surv.append({'n':n,'j':j,'rough_blocks':cs,'higher_carry_witnesses':c})
   if not c: original_nc.append([n,j])
res={'status':'BOUNDED_DIAGNOSTIC_NOT_PROOF','n_max':N,'initial_candidates_tested':tested,'full_window_examples':surv,'actual_nc_examples':original_nc,'seconds':round(time.perf_counter()-start,6)}
root=Path(__file__).resolve().parents[1]
(root/'evidence/full_window_probe.json').write_text(json.dumps(res,indent=2)+'\n')
print(json.dumps({k:v for k,v in res.items() if k not in ['full_window_examples','actual_nc_examples']}))
print('examples',[(x['n'],x['j']) for x in surv[:8]],'nc',original_nc[:8])
