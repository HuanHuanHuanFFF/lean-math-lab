#!/usr/bin/env python3
"""Check the entire declared static source/expected-output surface."""
import hashlib,json,sys
from pathlib import Path
ROOT=Path(__file__).resolve().parent

def static_paths(root=ROOT):
    return sorted(p for p in root.rglob('*') if p.is_file()
                  and p.relative_to(root).parts[0]!='replay'
                  and p.name!='MANIFEST.json'
                  and '__pycache__' not in p.parts and p.suffix!='.pyc')
def snapshot(root=ROOT):
    return {str(p.relative_to(root)):{'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in static_paths(root)}
def verify(root=ROOT):
    m=json.loads((root/'MANIFEST.json').read_text());now=snapshot(root)
    if m['files']!=now:
        bad=sorted(set(m['files'])^set(now))
        bad+=sorted(k for k in set(now)&set(m['files']) if now[k]!=m['files'][k])
        raise RuntimeError('Manifest mismatch: '+', '.join(bad[:20]))
    return now
if __name__=='__main__':
    o=verify();print(json.dumps({'status':'PASS','static_files':len(o),'historical_math_verified':False}))
