 f='code/adopted_asym/rational_intervals.py';b=iz.read(f)
 assert (ROOT/'code/vendor/rational_intervals.py').read_bytes()==b
 adopted.append({'new_path':'code/vendor/rational_intervals.py','source_member':'i13/'+f,'sha256':digest(b)})
 src=iz.read('code/check_i13_cuts_independent.py').decode();body=src[src.index('SCALE=10**32'):src.index('def certify(row):')]
 assert (ROOT/'code/vendor/decimal_intervals.py').read_text().endswith(body)
