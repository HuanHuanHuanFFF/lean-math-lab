B699ContinuationSieve.survivors_card_inclusion_exclusion : ∀ (P : Finset ℕ) (b : ℕ),
  ↑(B699ContinuationSieve.survivors P b).card =
    ∑ t ∈ P.powerset, (-1) ^ t.card * ↑(B699ContinuationSieve.intersections t b).card
'B699ContinuationSieve.restricted_inf_card' depends on axioms: [propext, Classical.choice, Quot.sound]
'B699ContinuationSieve.survivors_card_inclusion_exclusion' depends on axioms: [propext, Classical.choice, Quot.sound]
