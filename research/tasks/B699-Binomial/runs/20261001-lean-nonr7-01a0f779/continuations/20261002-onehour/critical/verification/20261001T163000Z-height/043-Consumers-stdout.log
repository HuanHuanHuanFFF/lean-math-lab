def Math.B699.CriticalWindowLog.ActualLogPair : ℕ → ℕ → Prop :=
fun n i =>
  ∃ p q a b A B,
    Math.B699.CriticalM64Windows.M64PairData n i p q a b A B ∧
      Math.B699.CriticalM64Windows.fullExponent n i p ≤ 15359 ∧
        Math.B699.CriticalM64Windows.fullExponent n i q ≤ 15359 ∧
          0 <
              |Math.B699.ZeroBoundaryWindowLog.linearForm A B p q (Math.B699.CriticalM64Windows.fullExponent n i p)
                  (Math.B699.CriticalM64Windows.fullExponent n i q)| ∧
            |Math.B699.ZeroBoundaryWindowLog.linearForm A B p q (Math.B699.CriticalM64Windows.fullExponent n i p)
                    (Math.B699.CriticalM64Windows.fullExponent n i q)| ≤
                33 / (↑n - 33) ∧
              |Math.B699.ZeroBoundaryWindowLog.linearForm A B p q (Math.B699.CriticalM64Windows.fullExponent n i p)
                    (Math.B699.CriticalM64Windows.fullExponent n i q)| <
                128 / ↑n
