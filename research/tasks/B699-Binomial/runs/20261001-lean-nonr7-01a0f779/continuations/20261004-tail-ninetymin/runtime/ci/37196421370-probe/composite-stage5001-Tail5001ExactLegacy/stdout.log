  5001 < j → j ≤ n / 2 → ∃ p, Nat.Prime p ∧ 5001 ≤ p ∧ p ∣ n.choose 5001 ∧ p ∣ n.choose j :=
fun n j hij hjn => B699TailNinety20261004.complete_5001 hij hjn
