B699ModernSieve.survivors_card_inclusion_exclusion : ∀ (P : Finset ℕ) (b : ℕ),
  ↑(B699ModernSieve.survivors P b).card = ∑ t ∈ P.powerset, (-1) ^ t.card * ↑(B699ModernSieve.intersections t b).card
'B699ModernSieve.restricted_inf_card' depends on axioms: [propext, Classical.choice, Quot.sound]
'B699ModernSieve.survivors_card_inclusion_exclusion' depends on axioms: [propext, Classical.choice, Quot.sound]
