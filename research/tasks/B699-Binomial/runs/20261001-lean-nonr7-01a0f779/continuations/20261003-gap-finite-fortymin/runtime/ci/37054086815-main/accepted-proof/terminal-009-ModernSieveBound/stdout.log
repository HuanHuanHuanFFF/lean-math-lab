@B699ModernSieve.primeCounting_sieve_upper : ∀ {P : Finset ℕ} {b : ℕ},
  P.Nonempty →
    (∀ q ∈ P, Nat.Prime q) → (∀ q ∈ P, q ≤ b) → b.primeCounting ≤ P.card - 1 + (B699ModernSieve.survivors P b).card
'B699ModernSieve.primeCounting_sieve_upper' depends on axioms: [propext, Classical.choice, Quot.sound]
