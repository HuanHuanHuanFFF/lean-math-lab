B699ModernSieve.survivors_card_floor_formula : ∀ (P : Finset ℕ),
  (∀ q ∈ P, Nat.Prime q) →
    ∀ (b : ℕ), ↑(B699ModernSieve.survivors P b).card = ∑ t ∈ P.powerset, (-1) ^ t.card * ↑(b / t.prod id)
