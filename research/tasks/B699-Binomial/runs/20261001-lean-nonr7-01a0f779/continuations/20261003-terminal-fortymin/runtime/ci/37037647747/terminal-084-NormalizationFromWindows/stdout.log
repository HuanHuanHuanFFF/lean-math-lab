@B699TailWindows.normalized_of_window_data : ∀ {n i j r s : ℕ},
  2 ≤ i →
    i < j →
      j ≤ n / 2 →
        s < i →
          ¬Common n i j →
            0 < 2 * s - r →
              3 * windowDegree i r s ≤ (2 * s - r) * (2 * i + 5) →
                ↑(2 * s - r) * log ↑i.factorial ≤
                    log ↑(windowConstant i r s) + (↑(2 * s - r) * (↑i + 3) - ↑(windowDegree i r s)) * log ↑i →
                  B699TailWindows.Normalized n i
