B699TailFactorial.log_factorial_bounds : ∀ (n : ℕ),
  1 ≤ n → ↑n * log ↑n - ↑n + 1 ≤ log ↑n.factorial ∧ log ↑n.factorial ≤ ↑n * log ↑n - ↑n + 1 + log ↑n
B699TailFactorial.log_superFactorial_lower : ∀ (q : ℕ),
  1 ≤ q → 1 / 2 * ↑q ^ 2 * log ↑q - 3 / 4 * ↑q ^ 2 + 1 / 2 * ↑q + 1 / 4 ≤ log ↑q.superFactorial
