@[expose] def B699TailGap.RealGap : ℕ → ℕ → Prop :=
fun D Y => ∀ (x : ℝ), ↑Y ≤ x → ∃ p, Nat.Prime p ∧ x < ↑p ∧ ↑D * (↑p - x) ≤ x
'B699TailGap.real_gap_of_nat_gap' depends on axioms: [propext, Classical.choice, Quot.sound]
'B699TailGap.nat_gap_of_real_gap' depends on axioms: [propext, Classical.choice, Quot.sound]
'B699TailGap.nat_gap_iff_real_gap' depends on axioms: [propext, Classical.choice, Quot.sound]
