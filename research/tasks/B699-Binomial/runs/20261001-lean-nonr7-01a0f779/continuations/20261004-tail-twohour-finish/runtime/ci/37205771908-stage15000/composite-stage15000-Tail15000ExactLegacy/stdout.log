theorem B699TailUntil2020Verify20261004.complete_15000_exact : ∀ (n j : ℕ),
  15000 < j → j ≤ n / 2 → ∃ p, Nat.Prime p ∧ 15000 ≤ p ∧ p ∣ n.choose 15000 ∧ p ∣ n.choose j :=
fun n j hij hjn => B699TailUntil202020261004.complete_15000 hij hjn
'B699TailUntil2020Verify20261004.complete_15000_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem B699TailUntil2020Verify20261004.all_upto_15000_exact : ∀ (n i j : ℕ),
  4883 ≤ i → i ≤ 15000 → i < j → j ≤ n / 2 → ∃ p, Nat.Prime p ∧ i ≤ p ∧ p ∣ n.choose i ∧ p ∣ n.choose j :=
fun n i j hi hiu hij hjn => B699TailUntil202020261004.common_upto_15000 hi hiu hij hjn
'B699TailUntil2020Verify20261004.all_upto_15000_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
