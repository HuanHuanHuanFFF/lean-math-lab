theorem B699TailUntil2020Verify20261004.all_upto_13000_exact : ∀ (n i j : ℕ),
  4883 ≤ i → i ≤ 13000 → i < j → j ≤ n / 2 → ∃ p, Nat.Prime p ∧ i ≤ p ∧ p ∣ n.choose i ∧ p ∣ n.choose j :=
fun n i j hi hiu hij hjn => B699TailUntil202020261004.common_upto_13000 hi hiu hij hjn
