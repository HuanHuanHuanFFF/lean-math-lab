  13000 < j → j ≤ n / 2 → ∃ p, Nat.Prime p ∧ 13000 ≤ p ∧ p ∣ n.choose 13000 ∧ p ∣ n.choose j :=
fun n j hij hjn => B699TailUntil202020261004.complete_13000 hij hjn
