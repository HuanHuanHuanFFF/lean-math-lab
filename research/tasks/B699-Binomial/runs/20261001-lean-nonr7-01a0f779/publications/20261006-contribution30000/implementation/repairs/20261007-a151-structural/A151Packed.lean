    (hdegree:d60 i r s ≤ i * (2 * s - r))
    (hcertificate:i.factorial ^ (2 * s - r) * N ^ d60 i r s <
      d104 i r s * (N.descFactorial i) ^ (2 * s - r)):
    ∃ p:ℕ,p.Prime ∧ i ≤ p ∧ p ∣ Nat.gcd (n.choose i) (n.choose j):= by
