theorem d77 {N n a b:ℕ} (hNn:N ≤ n) (hab:a ≤ b):
    N ^ b * n ^ a ≤ n ^ b * N ^ a:= by
  have hN:N ^ b = N ^ a * N ^ (b - a):= by
    rw [← pow_add,Nat.add_sub_of_le hab]
  have hn:n ^ b = n ^ a * n ^ (b - a):= by
    rw [← pow_add,Nat.add_sub_of_le hab]
