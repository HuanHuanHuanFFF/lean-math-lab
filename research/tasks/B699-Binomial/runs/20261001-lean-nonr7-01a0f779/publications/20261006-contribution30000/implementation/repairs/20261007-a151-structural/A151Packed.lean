          (n ^ (i * (2 * s - r)) * (N.choose i) ^ (2 * s - r)):= by ring
      _ ≤ d104 i r s *
          (N ^ (i * (2 * s - r)) * (n.choose i) ^ (2 * s - r)):=
        Nat.mul_le_mul_left _ hratio
      _ = N ^ (i * (2 * s - r)) *
