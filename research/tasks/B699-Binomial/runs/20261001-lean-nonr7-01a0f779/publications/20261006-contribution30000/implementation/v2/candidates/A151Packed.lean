        unfold d61
        dsimp only
        omega
      by_cases hnhead:n ≤ b
      · refine ⟨(a,b),List.mem_cons_self,?_⟩
        unfold d61
        dsimp only
        omega
      · have hr:d33 (b + 1) hi rest = true:= by
          simpa only [d33,if_neg hempty,if_neg hbefore,if_neg hgap,
            if_neg hdone] using hcheck
        obtain ⟨J,hJ,hnJ⟩:= ih (b + 1) hi n hr (by omega) hhi
