  have hcover:= d101 a b c r s hsum
  have hexp:e * (2 * s - r) ≤ e * (s - b) + e * (s - c) + e * (a - r):= by
    simpa only [Nat.mul_add] using Nat.mul_le_mul_left e hcover
  have hpow:= Nat.pow_dvd_pow p hexp
