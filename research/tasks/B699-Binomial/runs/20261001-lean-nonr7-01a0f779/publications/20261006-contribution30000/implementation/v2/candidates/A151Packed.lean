theorem d22 {N i s:ℕ} (hsi:s < i) (hiN:i ≤ N):
    0 < d21 N s:= by
  unfold d21
  apply Finset.prod_pos
  intro h hh
  have:= (Finset.mem_Icc.mp hh).2
