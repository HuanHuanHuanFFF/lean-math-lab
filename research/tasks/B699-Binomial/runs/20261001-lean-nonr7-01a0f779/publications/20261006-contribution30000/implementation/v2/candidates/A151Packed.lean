theorem d73 {intervals:List d1}
    {cover:List d9} {I J:d1} {n:ℕ}
    (hcheck:d72 intervals cover = true)
    (hI:I ∈ intervals) (hJ:J ∈ intervals) (hcolours:I.1 ≠ J.1)
    (hIlow:I.2.1 ≤ n) (hIhigh:n ≤ I.2.2)
    (hJlow:J.2.1 ≤ n) (hJhigh:n ≤ J.2.2):
    ∃ K ∈ cover,d61 n K:= by
