theorem d14 {n i j r s:ℕ}
    (hi:2 ≤ i) (hij:i < j) (hjn:j ≤ n / 2) (hsi:s < i)
    (hno:¬ Common n i j):
    N3.d79 i (n.choose i) ^ (2 * s - r) ∣
