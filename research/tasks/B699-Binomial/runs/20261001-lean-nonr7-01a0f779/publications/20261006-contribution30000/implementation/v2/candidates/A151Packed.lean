      if hi < lo then true
      else if b < lo then d33 lo hi rest
      else if lo < a then false
      else if hi ≤ b then true
      else d33 (b + 1) hi rest
theorem d34 (cover:List d9):
    ∀ lo hi n:ℕ,d33 lo hi cover = true → lo ≤ n → n ≤ hi →
      ∃ I ∈ cover,d61 n I:= by
  induction cover with
  | nil =>
      intro lo hi n hcheck hlo hhi
      simp only [d33,decide_eq_true_eq] at hcheck
      omega
  | cons I rest ih =>
      obtain ⟨a,b⟩:= I
      intro lo hi n hcheck hlo hhi
      by_cases hempty:hi < lo
      · omega
      by_cases hbefore:b < lo
      · have hr:d33 lo hi rest = true:= by
          simpa only [d33,if_neg hempty,if_pos hbefore] using hcheck
        obtain ⟨J,hJ,hnJ⟩:= ih lo hi n hr hlo hhi
        exact ⟨J,List.mem_cons_of_mem _ hJ,hnJ⟩
      by_cases hgap:lo < a
