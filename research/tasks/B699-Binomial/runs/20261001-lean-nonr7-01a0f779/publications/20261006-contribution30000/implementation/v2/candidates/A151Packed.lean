def digit37 (c:Char):ℕ:=
  let n:= c.toNat
  if n ≤ 44 then n - 35 else if n = 46 then 10 else if n ≤ 64 then n - 37
    else if n = 91 then 28 else if n ≤ 96 then n - 64 else n - 90
end N5
namespace N5
def d88 (a b c d:Char):ℕ:=
  37 * (37 * (37 * digit37 a + digit37 b) + digit37 c) + digit37 d
end N5
namespace N5
def double37 (a b:Char):ℕ:= 37 * digit37 a + digit37 b
end N5
namespace N5
def d37 (divisors:List ℕ):ℕ → List Char → List d5
  | previous,k::a::b::c::d::e::f::g::h::rest =>
    let lo:= previous + d88 a b c d
    let witness:= if k.toNat = 35 then d10.topPrime (lo - double37 g h)
      else d10.largeDivisor (divisors[double37 g h]?.getD 0)
    ⟨lo,lo + double37 e f,witness⟩::d37 divisors lo rest
  | _,_ => []
end N5
