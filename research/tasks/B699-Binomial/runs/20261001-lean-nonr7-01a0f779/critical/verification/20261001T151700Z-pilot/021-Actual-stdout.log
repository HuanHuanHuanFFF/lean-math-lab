'Math.B699.ZeroBoundaryWindowLog.factorized_window_log' depends on axioms: [propext, Classical.choice, Quot.sound]
'Math.B699.ZeroBoundaryWindowLog.actual_linear_form_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
