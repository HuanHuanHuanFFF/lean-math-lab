  2 ≤ i →
    i < j →
      j ≤ n / 2 →
        s < i →
          ¬Common n i j →
            0 < 2 * s - r →
              3 * windowDegree i r s ≤ (2 * s - r) * (2 * i + 5) →
                ↑(2 * s - r) * log ↑i.factorial ≤
