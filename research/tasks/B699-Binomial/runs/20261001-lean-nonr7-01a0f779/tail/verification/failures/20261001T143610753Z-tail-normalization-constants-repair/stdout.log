B699TailNormalization.factorial_normalization : ∀ (m c : ℕ),
  333 ≤ m →
    1 ≤ c →
      c ≤ 3 →
        have i := 3 * m + c;
        have q := 2 * m;
        have lam := 3 * m - c + 1;
        ↑lam * log ↑i.factorial ≤
          ↑q * (↑q + 1) * log 2 + 3 * log ↑q.superFactorial + (↑lam * (↑i + 3) - 3 * ↑m * (↑q + 1)) * log ↑i
