B699TailParameters.normalization_parameters : ∀ (i : Nat),
  1000 ≤ i →
    ∃ m c q r lam,
      i = 3 * m + c ∧
        333 ≤ m ∧
          1 ≤ c ∧
            c ≤ 3 ∧
              q = 2 * m ∧
                r = m + c - 1 ∧
                  i - r - 1 = q ∧ 2 * q - r = lam ∧ lam = 3 * m - c + 1 ∧ i - 5 ≤ lam ∧ q < i ∧ 666 ≤ q ∧ 995 ≤ lam
'B699TailParameters.normalization_parameters' depends on axioms: [propext, Classical.choice, Quot.sound]
