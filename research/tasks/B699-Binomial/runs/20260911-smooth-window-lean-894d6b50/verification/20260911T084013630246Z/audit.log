B699.SmoothWindow.scaled_I_identity : ∀ (x y : ℤ),
  B699.SmoothWindow.quarticI (B699.SmoothWindow.fallingFour x) (B699.SmoothWindow.scaledB x y)
      (B699.SmoothWindow.scaledC x y) (B699.SmoothWindow.scaledD x y) (B699.SmoothWindow.fallingFour y) =
    72 * x * y * (x - 1) * (y - 1) * (x + y - 3) * (x + y - 2)
'B699.SmoothWindow.scaled_I_identity' depends on axioms: [propext, Quot.sound]
B699.SmoothWindow.scaled_J_identity : ∀ (x y : ℤ),
  B699.SmoothWindow.quarticJ (B699.SmoothWindow.fallingFour x) (B699.SmoothWindow.scaledB x y)
      (B699.SmoothWindow.scaledC x y) (B699.SmoothWindow.scaledD x y) (B699.SmoothWindow.fallingFour y) =
    -864 * x ^ 2 * y ^ 2 * (x - 1) * (y - 1) * (x + y - 3) ^ 2 * (x + y - 2)
'B699.SmoothWindow.scaled_J_identity' depends on axioms: [propext, Quot.sound]
B699.SmoothWindow.scaled_W_identity : ∀ (x y : ℤ),
  B699.SmoothWindow.quarticW (B699.SmoothWindow.fallingFour x) (B699.SmoothWindow.scaledB x y)
      (B699.SmoothWindow.scaledC x y) (B699.SmoothWindow.scaledD x y) (B699.SmoothWindow.fallingFour y) =
    -746496 * x ^ 3 * y ^ 3 * (x - 1) ^ 2 * (y - 1) ^ 2 * (x + y - 3) ^ 3 * (x + y - 2) ^ 2 *
      B699.SmoothWindow.discriminantQ x y
'B699.SmoothWindow.scaled_W_identity' depends on axioms: [propext, Quot.sound]
