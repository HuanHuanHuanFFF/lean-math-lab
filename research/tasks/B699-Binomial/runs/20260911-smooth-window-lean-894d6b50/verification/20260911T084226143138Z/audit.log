@B699.SmoothWindow.same_prime_above_of_local_congruence : ∀ {n j m : ℕ},
  4 ≤ m →
    (∃ p, Nat.Prime p ∧ 5 ≤ p ∧ p ∣ n.choose 4 ∧ p ∣ n.choose j) →
      (∀ (p : ℕ), Nat.Prime p → 5 ≤ p → p ≤ m → n ≡ 4 [MOD p]) →
        ∃ p, Nat.Prime p ∧ m < p ∧ p ∣ n.choose j ∧ ∀ (i : ℕ), 4 ≤ i → i ≤ m → i < j → p ∣ n.choose i
'B699.SmoothWindow.same_prime_above_of_local_congruence' depends on axioms: [propext, Classical.choice, Quot.sound]
@B699.SmoothWindow.same_prime_above_of_product_congruence : ∀ {n j m : ℕ},
  4 ≤ m →
    (∃ p, Nat.Prime p ∧ 5 ≤ p ∧ p ∣ n.choose 4 ∧ p ∣ n.choose j) →
      n ≡ 4 [MOD B699.SmoothWindow.primeProduct m] →
        ∃ p, Nat.Prime p ∧ m < p ∧ p ∣ n.choose j ∧ ∀ (i : ℕ), 4 ≤ i → i ≤ m → i < j → p ∣ n.choose i
'B699.SmoothWindow.same_prime_above_of_product_congruence' depends on axioms: [propext, Classical.choice, Quot.sound]
