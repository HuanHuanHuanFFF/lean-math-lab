B699.SmoothWindow.quarticI_scale : ∀ (q a b c d e : ℤ),
  B699.SmoothWindow.quarticI (q * a) (q * b) (q * c) (q * d) (q * e) = q ^ 2 * B699.SmoothWindow.quarticI a b c d e
'B699.SmoothWindow.quarticI_scale' depends on axioms: [propext, Quot.sound]
B699.SmoothWindow.quarticJ_scale : ∀ (q a b c d e : ℤ),
  B699.SmoothWindow.quarticJ (q * a) (q * b) (q * c) (q * d) (q * e) = q ^ 3 * B699.SmoothWindow.quarticJ a b c d e
'B699.SmoothWindow.quarticJ_scale' depends on axioms: [propext, Quot.sound]
B699.SmoothWindow.quarticW_scale : ∀ (q a b c d e : ℤ),
  B699.SmoothWindow.quarticW (q * a) (q * b) (q * c) (q * d) (q * e) = q ^ 6 * B699.SmoothWindow.quarticW a b c d e
'B699.SmoothWindow.quarticW_scale' depends on axioms: [propext, Quot.sound]
